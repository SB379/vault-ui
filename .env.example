# Base URL of the vault-core REST API (server-side reads only).
# Defaults to the local hybrid stack if unset.
API_BASE=http://localhost:8000

# Supabase Auth — required only to gate the Curate control plane in production.
# Leave both unset for local dev: auth is bypassed and Curate stays open/demoable.
# Get these from your Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
